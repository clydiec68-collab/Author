# ============================================
# Clydie Cronjé Author Website — Environment Variables
# Copy this file to .env.local and fill in your keys
# ============================================

# Paystack — get from https://dashboard.paystack.com/#/settings/developers
# Use test keys during development, live keys in production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Payhip — your store username (for direct links)
NEXT_PUBLIC_PAYHIP_STORE=ClydieCronje

# Books2Read / Draft2Digital — your author page custom URL
NEXT_PUBLIC_BOOKS2READ_AUTHOR=https://books2read.com/ap/ClydieCronje

# Optional: Newsletter provider API key (for server-side subscribe route)
# MAILCHIMP_API_KEY=
# MAILERLITE_API_KEY=
